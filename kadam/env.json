{
    "$schema": "https://encore.dev/schemas/infra.schema.json",
    "metadata": {
        "app_id": "kadam-dq3i",
        "env_name": "staging",
        "env_type": "staging",
        "cloud": "aws",
        "base_url": "https://staging-kadam-dq3i.encr.app"
    },
    "sql_servers": [
        {
            "host": "my-db-host:5432",
            "databases": {
                "my-db": {
                    "username": "my-db-owner",
                    "password": {
                        "$env": "DB_PASSWORD"
                    }
                }
            }
        }
    ],
    "redis": {
        "encoreredis": {
            "database_index": 0,
            "auth": {
                "type": "acl",
                "username": "encoreredis",
                "password": {
                    "$env": "REDIS_PASSWORD"
                }
            },
            "host": "my-redis-host"
        }
    },
    "object_storage": [
        {
            "type": "gcs",
            "buckets": {
                "my-gcs-bucket": {
                    "name": "my-gcs-bucket"
                }
            }
        }
    ]
}
