# Kadam Backend Environment Configuration
# Copy this file to .env and update the values as needed

# ===========================================
# APPLICATION SETTINGS
# ===========================================
NODE_ENV=local
PORT=3001
DOMAIN=http://localhost
LOG_LEVEL=info

# ===========================================
# DATABASE SETTINGS
# ===========================================
# Local Development Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kadam_db
DB_USER=postgres
DB_PASSWORD=password

# Railway Database (Production)
# DB_HOST=shuttle.proxy.rlwy.net
# DB_PORT=48233
# DB_NAME=railway
# DB_USER=postgres
# DB_PASSWORD=NFD2y3DKKQzRRokyOTep4pnacOvgKsaP

# ===========================================
# REDIS CACHE SETTINGS
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ===========================================
# OPENTELEMETRY TRACING
# ===========================================
OTEL_SERVICE_NAME=kadam-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ===========================================
# AWS S3 CONFIGURATION
# ===========================================
# AWS Credentials
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# S3 Bucket Names
AWS_S3_COURSES_BUCKET=kadam-courses-bucket
AWS_S3_RAW_VIDEOS_BUCKET=kadam-raw-videos-bucket
AWS_S3_PROCESSED_VIDEOS_BUCKET=kadam-processed-videos-bucket

# ===========================================
# DEVELOPMENT NOTES
# ===========================================
# 1. For local development, use the local database settings
# 2. For production, uncomment the Railway database settings
# 3. Update JWT_SECRET with a strong, unique secret
# 4. Configure AWS credentials and bucket names for S3 functionality
# 5. Redis can be configured with authentication if needed
# 6. OpenTelemetry endpoint can be configured for monitoring
